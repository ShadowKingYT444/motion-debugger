{
  "tools": [
    {
      "name": "motion_capture",
      "title": "Capture local motion evidence",
      "description": "Run an explicit bounded click/hover/key/pointer/scroll recipe against a caller-chosen loopback URL and CSS target. Scroll deltas are limited to \u00b11200 pixels per action. Fresh browser; may change local app state. Saves actual WebM, screenshots and temporal evidence. Never imports credentials or edits code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "recipe": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "label": {
                "type": "string",
                "maxLength": 120
              },
              "actions": {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "const": "click"
                        },
                        "selector": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "action",
                        "selector"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "const": "hover"
                        },
                        "selector": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "action",
                        "selector"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "const": "key"
                        },
                        "key": {
                          "type": "string",
                          "enum": [
                            "Escape",
                            "Enter",
                            "Space",
                            "Tab",
                            "ArrowLeft",
                            "ArrowRight",
                            "ArrowUp",
                            "ArrowDown"
                          ]
                        }
                      },
                      "required": [
                        "action",
                        "key"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "const": "move"
                        },
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1920
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1200
                        }
                      },
                      "required": [
                        "action",
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "const": "scroll"
                        },
                        "deltaY": {
                          "type": "integer",
                          "minimum": -1200,
                          "maximum": 1200
                        }
                      },
                      "required": [
                        "action",
                        "deltaY"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "const": "wait"
                        },
                        "ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4000
                        }
                      },
                      "required": [
                        "action",
                        "ms"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "durationMs": {
                "type": "integer",
                "minimum": 500,
                "maximum": 12000
              },
              "viewport": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 320,
                    "maximum": 1920
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 320,
                    "maximum": 1200
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "reducedMotion": {
                "type": "string",
                "enum": [
                  "reduce",
                  "no-preference"
                ]
              },
              "contract": {
                "type": "object",
                "properties": {
                  "targetPresence": {
                    "type": "string",
                    "enum": [
                      "continuous",
                      "may-disappear"
                    ]
                  },
                  "maxFrameStepPx": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2000
                  },
                  "maxStepAt60HzPx": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2000
                  },
                  "maxSampleGapMs": {
                    "type": "number",
                    "minimum": 16,
                    "maximum": 1000
                  },
                  "maxHeightStepPx": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2000
                  },
                  "maxOpacityDrop": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "maxReplacements": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "maxActiveCancels": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50
                  },
                  "containment": {
                    "type": "object",
                    "properties": {
                      "selector": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "shape": {
                        "type": "string",
                        "enum": [
                          "rect",
                          "circle"
                        ]
                      },
                      "maxOverflowPx": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2000
                      },
                      "minOpacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "selector",
                      "maxOverflowPx"
                    ],
                    "additionalProperties": false
                  },
                  "final": {
                    "type": "object",
                    "properties": {
                      "selector": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "attributes": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "textIncludes": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "visible": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "sourceRefs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 80
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "file",
                    "line"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "url",
              "selector",
              "actions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "recipe"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "motion_inspect",
      "title": "Inspect a motion capture",
      "description": "Return compact measured contracts, findings, final state and artifact paths. Optionally return selected events and a bounded sample window; no arbitrary file reads.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "captureId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fromMs": {
            "type": "number",
            "minimum": 0
          },
          "toMs": {
            "type": "number",
            "minimum": 0
          },
          "includeSamples": {
            "type": "boolean"
          }
        },
        "required": [
          "captureId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "motion_compare",
      "title": "Compare before/after motion evidence",
      "description": "Compare measured temporal contracts and final state across two captures. Reports evidence deltas, not automated repair or an LLM benchmark.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "beforeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "afterId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "beforeId",
          "afterId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "motion_frames",
      "title": "See recorded motion frames",
      "description": "Return up to six actual recorded-video frames as native MCP images. Defaults to a reported failure or observed motion event. No rerendering, arbitrary paths or external URLs. Video-time alignment is approximate; use the trace for precise metrics.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "captureId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "timestampsMs": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 12000
            }
          }
        },
        "required": [
          "captureId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "motion_list",
      "title": "List local motion captures",
      "description": "List IDs from this server\u2019s configured evidence directory; does not search arbitrary files.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
