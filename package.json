{
  "name": "motion-debugger",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.library.json && vite build --configLoader runner && node scripts-build.mjs",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/qa.test.ts tests/analysis.test.ts tests/api.test.ts",
    "capture": "node --import tsx server/capture-cli.ts",
    "check": "npm run build && npm test && npm run test:v2 && npm run test:cli && npm run test:workflow && npm run test:packages && npm run test:assembly && npm run test:critique",
    "test:e2e": "node --import tsx --test tests/e2e.test.ts",
    "mcp": "node build/mcp/index.js",
    "cli": "node build/cli/index.js",
    "pack:check": "npm pack --dry-run",
    "test:v2": "node --import tsx --test tests/v2/*.test.ts",
    "test:v2:e2e": "node --import tsx tests/v2/e2e.ts",
    "prepack": "npm run build",
    "test:install": "node scripts/test-install.mjs",
    "test:cli": "node --import tsx --test tests/install/*.test.ts",
    "doctor": "node build/cli/index.js doctor",
    "demo": "node build/cli/index.js demo",
    "test:workflow": "node --test tests/workflow.test.mjs",
    "test:coverage:browser": "node --import tsx tests/v2/coverage-browser.ts",
    "test:failure:browser": "node --import tsx --test tests/v2/failure-evidence-browser.ts",
    "package:plugins": "node scripts/package-plugins.mjs",
    "test:packages": "node --test tests/plugin-packages.test.mjs",
    "test:outcomes:browser": "node --import tsx tests/v2/outcomes-browser.ts",
    "test:recipes:browser": "node --import tsx tests/v2/recipes-browser.mjs",
    "test:colony:browser": "node --import tsx tests/v2/colony-browser.mjs",
    "test:sequence:browser": "node --import tsx tests/v2/sequence-browser.mjs",
    "test:kinetic:browser": "node tests/v2/kinetic-field-browser.mjs",
    "test:drag:browser": "node --import tsx tests/v2/drag-browser.ts",
    "test:duration:browser": "node --import tsx tests/v2/duration-browser.ts",
    "test:actors:browser": "node --import tsx tests/v2/actor-calibration-browser.ts",
    "test:review:browser": "node --import tsx tests/v2/review-browser.ts",
    "test:transitions:browser": "node tests/v2/transition-patterns-browser.mjs",
    "demo:assembly": "node scripts/demo-assembly.mjs",
    "test:assembly:browser": "node tests/assembly-browser.mjs",
    "test:assembly": "node --test tests/assembly-scaffold.test.mjs",
    "test:authoring:browser": "node --import tsx tests/v2/authoring-browser.ts",
    "test:critique": "node --import tsx --test tests/critique.test.ts",
    "test:critique:browser": "node --import tsx tests/critique-browser.mjs",
    "test:kit:browser": "node --import tsx tests/motion-kit-browser.mjs",
    "test:stack:browser": "node --import tsx tests/motion-stack-browser.mjs",
    "critique": "node build/cli/index.js critique",
    "demo:record": "node demos/record.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "express": "5.2.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "description": "Premium motion design skill and a real-browser critic that help coding agents build and refine high-quality animated websites",
  "bin": {
    "motion-debugger": "build/cli/index.js",
    "motion-debugger-mcp": "build/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./build/types/packages/core/index.d.ts",
      "import": "./build/core/index.js"
    }
  },
  "files": [
    "build/",
    "plugin/",
    "README.md",
    "LICENSE",
    "docs/",
    "examples/recipes/"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadowKingYT444/motion-debugger.git"
  },
  "license": "MIT",
  "types": "./build/types/packages/core/index.d.ts",
  "keywords": [
    "motion",
    "animation",
    "debugger",
    "mcp",
    "coding-agents",
    "playwright",
    "premium-ui",
    "web-design",
    "critique",
    "agent-skills",
    "provider-agnostic"
  ]
}
