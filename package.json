{
  "name": "motion-debugger",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.library.json && vite build && node scripts-build.mjs",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/qa.test.ts tests/analysis.test.ts tests/api.test.ts",
    "capture": "node --import tsx server/capture-cli.ts",
    "check": "npm run build && npm test && npm run test:v2 && npm run test:cli",
    "test:e2e": "node --import tsx --test tests/e2e.test.ts",
    "mcp": "node build/mcp/index.js",
    "cli": "node build/cli/index.js",
    "pack:check": "npm pack --dry-run",
    "test:v2": "node --import tsx --test tests/v2/*.test.ts",
    "test:v2:e2e": "node --import tsx tests/v2/e2e.ts",
    "prepack": "npm run build",
    "test:install": "node scripts/test-install.mjs",
    "test:cli": "node --import tsx --test tests/install/cli.test.ts",
    "doctor": "node build/cli/index.js doctor",
    "demo": "node build/cli/index.js demo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "description": "Local temporal motion evidence for coding agents: library, CLI and MCP",
  "bin": {
    "motion-debugger": "build/cli/index.js",
    "motion-debugger-mcp": "build/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./build/types/packages/core/index.d.ts",
      "import": "./build/core/index.js"
    }
  },
  "files": [
    "build/",
    "plugin/",
    "README.md",
    "docs/",
    "examples/recipes/"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadowKingYT444/motion-debugger.git"
  },
  "license": "UNLICENSED",
  "types": "./build/types/packages/core/index.d.ts",
  "keywords": [
    "motion",
    "animation",
    "debugger",
    "mcp",
    "coding-agents",
    "playwright"
  ]
}
